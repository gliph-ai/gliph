#!/usr/bin/env bash
# Put the secrets .github/workflows/release.yml needs onto the GitHub repo. Run once, and again after
# rotating a key. Needs `gh auth login` and `glab` (the deploy token is read from GitLab once; pass
# PUSHLEFT_TOKEN to skip that). Same Apple keys as Sidra's tools/release-secrets.
#
# The updater key is Gliph's own (~/.gliph-updater-key, a copy of ~/Desktop/gliph-updater-key; losing it
# strands every installed copy). The bucket key is the `files` bucket's own S3 key (~/.gliph-files-bucket.env,
# from the PushLeft agent): it reaches that one bucket only.
set -euo pipefail
REPO=${REPO:-gliph-ai/gliph}
KEY=${GLIPH_UPDATER_KEY_DIR:-$HOME/.gliph-updater-key}
P12_DIR=${APPLE_P12_DIR:-$HOME/.inbox2-updater-key}
ASC=${APPLE_API_KEY:-H9PLG58DB9}
ISSUER=${APPLE_API_ISSUER:-d5f5385b-5e34-4d70-925d-0debd3a3e090}
BUCKET_ENV=${GLIPH_BUCKET_ENV:-$HOME/.gliph-files-bucket.env}
set_() { printf %s "$2" | gh secret set "$1" -R "$REPO" >/dev/null && echo "set $1"; }

set_ TAURI_SIGNING_PRIVATE_KEY "$(cat "$KEY/gliph.key")"
set_ TAURI_SIGNING_PRIVATE_KEY_PASSWORD "$(cat "$KEY/password.txt")"

# The shared .p12 leads with Apple Development; re-pack just the Developer ID cert and its key so
# nothing else can end up signing a release.
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
openssl pkcs12 -legacy -in "$P12_DIR/apple-signing-identities.p12" -passin file:"$P12_DIR/apple-signing-p12-password.txt" -nodes -out "$TMP/all.pem"
python3 - "$TMP" <<'PY'
import re, sys
d = sys.argv[1]; pem = open(f"{d}/all.pem").read()
blocks = re.findall(r"Bag Attributes.*?-----END [A-Z ]+-----", pem, re.S)
kid = lambda b: re.search(r"localKeyID: ([0-9A-F ]+)", b).group(1)
cert = next(b for b in blocks if "BEGIN CERTIFICATE" in b and "CN=Developer ID Application" in b.replace(" = ", "="))
key = next(b for b in blocks if "PRIVATE KEY" in b and kid(b) == kid(cert))
strip = lambda b: b[b.index("-----BEGIN"):] + "\n"
open(f"{d}/cert.pem", "w").write(strip(cert)); open(f"{d}/key.pem", "w").write(strip(key))
PY
openssl pkcs12 -export -legacy -in "$TMP/cert.pem" -inkey "$TMP/key.pem" -passout file:"$P12_DIR/apple-signing-p12-password.txt" -out "$TMP/devid.p12"
set_ APPLE_CERTIFICATE "$(base64 -i "$TMP/devid.p12")"
set_ APPLE_CERTIFICATE_PASSWORD "$(cat "$P12_DIR/apple-signing-p12-password.txt")"
set_ APPLE_SIGNING_IDENTITY "$(security find-identity -v -p codesigning | sed -n 's/.*"\(Developer ID Application: .*\)"/\1/p' | head -1)"
set_ APPLE_API_KEY "$ASC"
set_ APPLE_API_ISSUER "$ISSUER"
set_ APPLE_API_KEY_P8 "$(cat "$HOME/.appstoreconnect/private_keys/AuthKey_$ASC.p8")"

while IFS='=' read -r k v; do
  case "$k" in S3_ENDPOINT|S3_BUCKET|AWS_REGION|AWS_ACCESS_KEY_ID|AWS_SECRET_ACCESS_KEY) set_ "$k" "$v" ;; esac
done < "$BUCKET_ENV"

set_ PUSHLEFT_TOKEN "${PUSHLEFT_TOKEN:-$(glab api projects/66/variables/PUSHLEFT_TOKEN --hostname git.erip.me | python3 -c 'import json,sys; sys.stdout.write(json.load(sys.stdin)["value"])')}"
