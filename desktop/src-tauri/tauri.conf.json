{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gliph",
  "mainBinaryName": "Gliph",
  "version": "0.2.0",
  "identifier": "chat.gliph.desktop",
  "build": {
    "devUrl": "http://localhost:5184",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1200,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 13, "y": 31 },
        "dragDropEnabled": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src * blob: ws: wss: ipc: http://ipc.localhost; frame-src https://www.youtube-nocookie.com https://embed.diagrams.net blob:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright (c) 2026 The Gliph authors",
    "license": "MIT OR Apache-2.0",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
